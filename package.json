{
  "name": "riso",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Turn any image into a Risograph print in the browser: 1-4 inks, grain, misregistration, outlines and print-ready per-ink files.",
  "scripts": {
    "dev": "vite --config riso-app/vite.config.ts",
    "build": "tsc -p riso-app && vite build --config riso-app/vite.config.ts",
    "preview": "vite preview --config riso-app/vite.config.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
